# Copy to api/.env on the server. Do not commit that copy.
# The phone never receives these values.

ADDR=:8080

# Shared development credential for the phone. This is not the Anthropic key.
# Send it as: Authorization: Bearer <DEV_TOKEN>
DEV_TOKEN=replace-me

# Advisor provider. claude is the one this service starts with.
AI_PROVIDER=claude

# Anthropic API key, from console.anthropic.com. Set it here or export it
# in the server environment. Leave it out of the iOS app and out of git.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5 when empty.
AI_MODEL=claude-sonnet-5-5
